<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" modified="2026-11-23T15:45:00.000Z" agent="draw.io" version="24.0.0" type="device"><diagram id="arch-overview" name="1. 总体架构与主要模块 (Architecture &amp; Modules)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="p_arch-overview" parent="0" /><mxCell id="t1" value="&lt;b&gt;&lt;font style='font-size: 20px;'&gt;Kagent Platform Guardian 生产架构与核心模块拓扑规范图 (Architecture v2.0)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 12px; color: #64748B;'&gt;高可用混合巡检、MCP 网关深度防御、No Hot-Patching 刚性门禁与纯 GitHub 闭环运营&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="p_arch-overview"><mxGeometry x="40" y="20" width="1550" height="50" as="geometry" /></mxCell><mxCell id="l1" value="&lt;b&gt;触发与周期调度层 (Triggers &amp;amp; Scheduling Layer)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="50" y="90" width="1530" height="130" as="geometry" /></mxCell><mxCell id="m_ui" value="&lt;b&gt;SRE Web UI 控制台&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;:30083/agents/chat&lt;br/&gt;交互式提问 / 巡检 / 自愈核准&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="80" y="130" width="250" height="70" as="geometry" /></mxCell><mxCell id="m_sentinel" value="&lt;b&gt;外部轻量哨兵 (Sentinel)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;kagent-guardian-sentinel&lt;br/&gt;15min 物理巡检 / &amp;ge;85分短路&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="370" y="130" width="260" height="70" as="geometry" /></mxCell><mxCell id="m_archiver" value="&lt;b&gt;日终账本归档 (Archiver)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;kagent-guardian-ledger-archiver&lt;br/&gt;23:55 自动签名归档 GitHub 账本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="670" y="130" width="270" height="70" as="geometry" /></mxCell><mxCell id="m_gc" value="&lt;b&gt;生命周期回收 (Session GC)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;kagent-guardian-session-gc&lt;br/&gt;定时清理超过 7 天历史会话数据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="980" y="130" width="260" height="70" as="geometry" /></mxCell><mxCell id="m_alert" value="&lt;b&gt;外部告警协同 (Alertmanager)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;Webhook 告警唤醒&lt;br/&gt;故障排查与深度下钻分析&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="1280" y="130" width="260" height="70" as="geometry" /></mxCell><mxCell id="l2" value="&lt;b&gt;平台治理与安全门禁层 (Governance &amp;amp; Security Enclosure Layer)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#581C87;fontStyle=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="50" y="250" width="1530" height="130" as="geometry" /></mxCell><mxCell id="m_lease" value="&lt;b&gt;分布式排他租约锁 (Lease Lock)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;coordination.k8s.io/leases/kagent-guardian-lock&lt;br/&gt;抢占机制 / 心跳保持 / TTL 600s 脑裂防线&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="80" y="290" width="430" height="70" as="geometry" /></mxCell><mxCell id="m_snapshot" value="&lt;b&gt;Substrate 预编译黄金快照 (Golden Snapshot)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;ActorTemplate GoldenSnapshotReady 门禁&lt;br/&gt;秒级冷启动 (&amp;le;3.5s) / 沙箱内存预热&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="540" y="290" width="480" height="70" as="geometry" /></mxCell><mxCell id="m_pep" value="&lt;b&gt;策略决策与拦截点 (PEP / PDP Enclosure)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;No Hot-Patching 刚性阻断 / Fail-Closed 降级&lt;br/&gt;HITL 人机协同审批流 (5s 轮询 / 300s 超时)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="1050" y="290" width="490" height="70" as="geometry" /></mxCell><mxCell id="l3" value="&lt;b&gt;核心智能体认知与决策引擎 (Agent Core Decision Engine) - kagent-guardian-agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#14532D;fontStyle=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="50" y="410" width="1530" height="160" as="geometry" /></mxCell><mxCell id="m_sop" value="&lt;b&gt;L1-L4 阶梯巡检 SOP 推理机&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;L1: 物理节点基座 &amp;amp; 水位&lt;br/&gt;L2: 运行时 CFS 节流 &amp;amp; 网关&lt;br/&gt;L3: 控制面状态机 &amp;amp; PG 库&lt;br/&gt;L4: 黄金快照与沙箱探针&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="80" y="450" width="330" height="100" as="geometry" /></mxCell><mxCell id="m_tree" value="&lt;b&gt;CFS 算力与冷启动双因子决策树&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;指标 A: CFS 节流比 (throttled_periods / periods &amp;gt; 20%)&lt;br/&gt;指标 B: 唤醒耗时 (cold_start_duration &amp;gt; 3000ms)&lt;br/&gt;精准识别算力节流 vs 临时沙箱初始化耗时&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="440" y="450" width="390" height="100" as="geometry" /></mxCell><mxCell id="m_evidence" value="&lt;b&gt;证据第一与事实三态分类器&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• CONFIRMED FACTS: 真实指标与日志证据&lt;br/&gt;• SUSPECTED HYPOTHESES: 架构推导假设&lt;br/&gt;• UNKNOWN / MISSING: 盲区严禁大模型脑补&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="860" y="450" width="340" height="100" as="geometry" /></mxCell><mxCell id="m_dual_out" value="&lt;b&gt;双模结构化输出格式化器&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;模式 1: 极简 Markdown 绿色健康体检卡片&lt;br/&gt;模式 2: 深度排障报告【现象+根因+GitOps PR 提案】&lt;br/&gt;符合 SRE 认知心智模型&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="1230" y="450" width="310" height="100" as="geometry" /></mxCell><mxCell id="l4" value="&lt;b&gt;企业级统一网关与四元组工具组 (Enterprise MCP Gateway &amp;amp; Quad-Tool Cluster)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontStyle=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="50" y="600" width="1530" height="240" as="geometry" /></mxCell><mxCell id="m_gw_core" value="&lt;b&gt;agentstage-mcp-gateway 网关核心&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;统一反向代理 (Port 8080) / Bearer Session 鉴权 / 白名单硬隔离 / 消除 duplicate tool 冲突&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="80" y="640" width="1470" height="40" as="geometry" /></mxCell><mxCell id="t_k8s" value="&lt;b&gt;mcp-proxy-k8s-read&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;&lt;b&gt;K8s 只读拓扑与日志&lt;/b&gt;&lt;br/&gt;• k8s_get_resources&lt;br/&gt;• k8s_describe_resource&lt;br/&gt;• k8s_get_events&lt;br/&gt;• k8s_get_pod_logs&lt;br/&gt;• k8s_check_service_connectivity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="80" y="695" width="340" height="130" as="geometry" /></mxCell><mxCell id="t_kagent" value="&lt;b&gt;mcp-proxy-kagent-tool&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;&lt;b&gt;监控指标与灰度发布&lt;/b&gt;&lt;br/&gt;• prometheus_promql_tool&lt;br/&gt;• prometheus_query_tool&lt;br/&gt;• argo_rollouts_list&lt;br/&gt;• argo_check_plugin_logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="450" y="695" width="340" height="130" as="geometry" /></mxCell><mxCell id="t_k8sgpt" value="&lt;b&gt;mcp-proxy-k8sgpt-read&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;&lt;b&gt;AI 智能异常聚类诊断&lt;/b&gt;&lt;br/&gt;• analyze (聚类扫描)&lt;br/&gt;• cluster-info (集群概要)&lt;br/&gt;• get-logs (错误提取)&lt;br/&gt;• list-events (异常聚合)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="820" y="695" width="340" height="130" as="geometry" /></mxCell><mxCell id="t_github" value="&lt;b&gt;mcp-proxy-github-ops&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;&lt;b&gt;GitOps 闭环与审批核查&lt;/b&gt;&lt;br/&gt;• github_create_branch&lt;br/&gt;• github_create_or_update_file&lt;br/&gt;• github_create_pull_request&lt;br/&gt;• &lt;b&gt;agentstage_approval_result&lt;/b&gt; (独占)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="1190" y="695" width="360" height="130" as="geometry" /></mxCell><mxCell id="l5" value="&lt;b&gt;底座基础设施、被测运行时与 GitOps 唯一真实源 (Infrastructure &amp;amp; GitOps Operations Center)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="p_arch-overview"><mxGeometry x="50" y="870" width="1530" height="210" as="geometry" /></mxCell><mxCell id="tgt_k8s" value="&lt;b&gt;Kubernetes 生产集群底座&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• Nodes (Ready/DiskPressure/MemoryPressure)&lt;br/&gt;• kagent-controller (CRD 调谐状态机)&lt;br/&gt;• atenet-router (流量网关 &amp;amp; 延迟探针)&lt;br/&gt;• kagent-postgresql (持久化数据库连接池)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="80" y="915" width="340" height="145" as="geometry" /></mxCell><mxCell id="tgt_prom" value="&lt;b&gt;Prometheus 生产监控度量时序库&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• container_cpu_cfs_throttled_periods_total&lt;br/&gt;• kagent_sandbox_wakeup_duration_seconds&lt;br/&gt;• node_cpu_seconds_total / memory_working_set&lt;br/&gt;• http_requests_total (5xx/4xx 流量监控)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="450" y="915" width="340" height="145" as="geometry" /></mxCell><mxCell id="tgt_k8sgpt" value="&lt;b&gt;K8sGPT AI 诊断引擎 Pod&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• 后台扫描 Kubernetes 资源异常事件&lt;br/&gt;• 聚类 OOMKilled、CrashLoopBackOff、Evicted&lt;br/&gt;• 输出标准化语义故障原因分析报告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="820" y="915" width="340" height="145" as="geometry" /></mxCell><mxCell id="tgt_github" value="&lt;b&gt;GitHub 仓库: SDB-DevOps/KagentGuardian&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;&lt;b&gt;GitOps 单一真实源 (Single Source of Truth)&lt;/b&gt;&lt;br/&gt;• 故障预警 Issue (Title Hash 幂等防刷屏)&lt;br/&gt;• 自愈声明式 PR (Fixes #Issue 自愈闭环)&lt;br/&gt;• docs/patrol-reports/ 巡检绿色日终健康账本&lt;br/&gt;• ArgoCD 声明式调谐联动回放&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_arch-overview"><mxGeometry x="1190" y="915" width="360" height="145" as="geometry" /></mxCell><mxCell id="e1" value="唤醒/交互" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_ui" target="m_pep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="&lt;85分抢占唤醒" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_sentinel" target="m_lease"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="放行调谐" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_lease" target="m_sop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="快照预热" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_snapshot" target="m_sop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="受控调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_sop" target="m_gw_core"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="双因子决策" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_sop" target="m_tree"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="事实输出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="m_evidence" target="m_dual_out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="只读探测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="t_k8s" target="tgt_k8s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="PromQL查询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="t_kagent" target="tgt_prom"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="AI聚类" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="t_k8sgpt" target="tgt_k8sgpt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="提 PR / Issue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#475569;" edge="1" parent="p_arch-overview" source="t_github" target="tgt_github"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="workflow-flow" name="2. 工作时序与自愈闭环流 (How It Works: Workflow &amp; Self-Healing)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="p_workflow-flow" parent="0" /><mxCell id="w_title" value="&lt;b&gt;&lt;font style='font-size: 20px;'&gt;Kagent Platform Guardian 端到端工作时序与自愈闭环时序规约 (Execution Workflow)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 12px; color: #64748B;'&gt;阶梯短路智能巡检流、Web UI 交互热修拦截门禁、PEP HITL 审批与 GitOps 自动化声明式自愈闭环&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="p_workflow-flow"><mxGeometry x="40" y="20" width="1550" height="50" as="geometry" /></mxCell><mxCell id="w1_box" value="&lt;b&gt;主流程一：阶梯短路混合巡检流 (Tiered Short-Circuit Patrol &amp;amp; Auto-Remediation)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#0369A1;fontStyle=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="50" y="90" width="1530" height="480" as="geometry" /></mxCell><mxCell id="step1" value="&lt;b&gt;1. 哨兵定时唤醒&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;Sentinel CronJob&lt;br/&gt;每 15 分钟触发运行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="80" y="140" width="170" height="70" as="geometry" /></mxCell><mxCell id="step2" value="&lt;b&gt;2. 物理指标快速采集&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;只读抓取 Node / Pod / 5xx&lt;br/&gt;&lt;b&gt;0 Token 消耗&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="290" y="140" width="190" height="70" as="geometry" /></mxCell><mxCell id="step3" value="&lt;b&gt;3. 健康基线加权计算&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;加权打分 (0-100)&lt;br/&gt;健康及格线: &lt;b&gt;85 分&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="520" y="140" width="180" height="70" as="geometry" /></mxCell><mxCell id="cond1" value="&lt;b&gt;健康得分&lt;br/&gt;&amp;ge; 85 分 ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontStyle=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="740" y="130" width="130" height="90" as="geometry" /></mxCell><mxCell id="branch_green" value="&lt;b&gt;短路落账 (Green Path)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#15803D;'&gt;常态巡检无黄色/红色报警&lt;br/&gt;直接通过 GitHub API 写入账本&lt;br/&gt;&lt;b&gt;实现 0 LLM Token 零成本开销&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="930" y="140" width="240" height="70" as="geometry" /></mxCell><mxCell id="end_green" value="&lt;b&gt;日终账本自动归档&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;docs/patrol-reports/&lt;br/&gt;绿色常态归档结束&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;arcSize=8;" vertex="1" parent="p_workflow-flow"><mxGeometry x="1220" y="140" width="180" height="70" as="geometry" /></mxCell><mxCell id="branch_red" value="&lt;b&gt;触发深度排查 (&amp;lt; 85分)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#B91C1C;'&gt;发现指标劣变或故障隐患&lt;br/&gt;启动排他锁竞争与唤醒&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="710" y="260" width="190" height="60" as="geometry" /></mxCell><mxCell id="lock_acquire" value="&lt;b&gt;4. 抢占 Lease 排他分布式锁&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;检查 coordination.k8s.io/leases/kagent-guardian-lock&lt;br/&gt;抢占成功继续；已被占用则排队避免并发脑裂&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="80" y="350" width="360" height="65" as="geometry" /></mxCell><mxCell id="agent_deep" value="&lt;b&gt;5. 唤醒 KagentGuardian Agent 深度排查&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• 调度 mcp-proxy-k8s-read 抓取 Pod 日志与 Events&lt;br/&gt;• 调度 mcp-proxy-k8sgpt-read 深度聚类分析&lt;br/&gt;• 调度 mcp-proxy-kagent-tool PromQL 计算 CFS 节流率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_workflow-flow"><mxGeometry x="470" y="350" width="420" height="65" as="geometry" /></mxCell><mxCell id="rca_step" value="&lt;b&gt;6. CFS 双因子归因与根因定位&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;比对 CFS 节流比 &amp;gt; 20% vs 冷启动耗时&lt;br/&gt;精准定位 CPU配额瓶颈 / 内存泄漏 / 沙箱未热&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="920" y="350" width="340" height="65" as="geometry" /></mxCell><mxCell id="issue_idemp" value="&lt;b&gt;7. GitHub Issue 查重幂等&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;Title Hash 比对已有工单&lt;br/&gt;防止告警风暴，活跃工单则追加评论&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="1290" y="350" width="260" height="65" as="geometry" /></mxCell><mxCell id="pr_step" value="&lt;b&gt;8. 生成声明式自愈 Diff 并提交 PR&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;向 SDB-DevOps/KagentGuardian 提交分支并创建 PR&lt;br/&gt;绑定 Fixes #&amp;lt;issue-id&amp;gt;，附带完整指标与日志证据链&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="80" y="450" width="440" height="70" as="geometry" /></mxCell><mxCell id="pep_wait" value="&lt;b&gt;9. PEP HITL 审批轮询与合入&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;agentstage_approval_result 5s轮询&lt;br/&gt;SRE 人工核准 -&amp;gt; Merge 合并 PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="560" y="450" width="330" height="70" as="geometry" /></mxCell><mxCell id="argocd_sync" value="&lt;b&gt;10. ArgoCD 自动调谐与闭环验证&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;ArgoCD GitOps 同步集群 YAML&lt;br/&gt;工作负载生效，复测通过，释放 Lease 锁&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="930" y="450" width="360" height="70" as="geometry" /></mxCell><mxCell id="end_red" value="&lt;b&gt;自愈闭环完成&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#15803D;'&gt;Issue 自动结单&lt;br/&gt;释放排他锁&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;arcSize=8;" vertex="1" parent="p_workflow-flow"><mxGeometry x="1330" y="450" width="180" height="70" as="geometry" /></mxCell><mxCell id="w2_box" value="&lt;b&gt;主流程二：Web UI 网页交互与生产零热修刚性防御流 (Web UI Interaction &amp;amp; No Hot-Patching Defense)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;arcSize=6;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#581C87;fontStyle=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="50" y="600" width="1530" height="480" as="geometry" /></mxCell><mxCell id="ui_msg" value="&lt;b&gt;SRE / 用户在 UI 发送指令&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• 巡检/体检指令 (TC-MAN-01)&lt;br/&gt;• 故障排查/日志提取 (TC-MAN-07)&lt;br/&gt;• &lt;b&gt;高危诱导热修变更 (TC-MAN-12)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="80" y="650" width="270" height="75" as="geometry" /></mxCell><mxCell id="agent_recv" value="&lt;b&gt;Agent 接收指令与意图识别&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;加载 Substrate 黄金快照&lt;br/&gt;启动系统提示词与安全防护围栏&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="390" y="650" width="250" height="75" as="geometry" /></mxCell><mxCell id="check_gate" value="&lt;b&gt;是否包含&lt;br/&gt;在线热修/直接写操作 ?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 10px; color:#64748B;'&gt;(如 scale / delete / patch)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="680" y="640" width="190" height="95" as="geometry" /></mxCell><mxCell id="def_block" value="&lt;b&gt;⚠️ 刚性拦截：No Hot-Patching 铁律&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#991B1B;'&gt;&lt;b&gt;100% 拒绝直连在线修改工作负载&lt;/b&gt;&lt;br/&gt;严禁调用 kubectl edit/patch/scale/delete&lt;br/&gt;坚决捍卫生产安全红线与只读边界&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="930" y="650" width="310" height="75" as="geometry" /></mxCell><mxCell id="def_guide" value="&lt;b&gt;规范引导 GitOps 自愈方案&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;生成合规的 YAML Diff 补丁&lt;br/&gt;告知用户提交 PR 至 GitHub 官方仓库&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="1280" y="650" width="260" height="75" as="geometry" /></mxCell><mxCell id="norm_probe" value="&lt;b&gt;合规只读排查与巡检流水线&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;通过 agentstage-mcp-gateway 分发调用：&lt;br/&gt;• mcp-proxy-k8s-read (Pod/Node/Events/Logs)&lt;br/&gt;• mcp-proxy-kagent-tool (PromQL 性能指标)&lt;br/&gt;• mcp-proxy-k8sgpt-read (AI 聚类诊断)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;arcSize=8;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="p_workflow-flow"><mxGeometry x="660" y="780" width="420" height="85" as="geometry" /></mxCell><mxCell id="fail_closed_check" value="&lt;b&gt;MCP 网关可用性校验&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• 若工具不可达/无上下文：&lt;b&gt;Fail-Closed&lt;/b&gt; 降级&lt;br/&gt;• &lt;b&gt;绝对严禁凭空伪造/猜测假指标&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="p_workflow-flow"><mxGeometry x="1120" y="780" width="340" height="85" as="geometry" /></mxCell><mxCell id="ui_render" value="&lt;b&gt;结构化双模式结果渲染输出至 Web UI&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color:#475569;'&gt;• &lt;b&gt;模式 1 (极简)&lt;/b&gt;: Markdown 健康大盘卡片 (评分 + 各层概览表格)&lt;br/&gt;• &lt;b&gt;模式 2 (深度)&lt;/b&gt;: 根因推导报告【物理证据链 + 拓扑下钻 + GitOps PR 建议】&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;arcSize=8;shadow=1;align=left;spacingLeft=15;" vertex="1" parent="p_workflow-flow"><mxGeometry x="660" y="910" width="800" height="75" as="geometry" /></mxCell><mxCell id="we1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0284C7;" edge="1" parent="p_workflow-flow" source="step1" target="step2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0284C7;" edge="1" parent="p_workflow-flow" source="step2" target="step3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0284C7;" edge="1" parent="p_workflow-flow" source="step3" target="cond1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we4" value="是 (&amp;ge;85)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;" edge="1" parent="p_workflow-flow" source="cond1" target="branch_green"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;" edge="1" parent="p_workflow-flow" source="branch_green" target="end_green"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we6" value="否 (&amp;lt;85)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="p_workflow-flow" source="cond1" target="branch_red"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="p_workflow-flow" source="branch_red" target="lock_acquire"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="380" /></Array></mxGeometry></mxCell><mxCell id="we8" value="加锁成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="p_workflow-flow" source="lock_acquire" target="agent_deep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="p_workflow-flow" source="agent_deep" target="rca_step"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="p_workflow-flow" source="rca_step" target="issue_idemp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we11" value="登记异常" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;" edge="1" parent="p_workflow-flow" source="issue_idemp" target="pr_step"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="430" /><mxPoint x="300" y="430" /></Array></mxGeometry></mxCell><mxCell id="we12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;" edge="1" parent="p_workflow-flow" source="pr_step" target="pep_wait"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="we13" value="审批通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;st